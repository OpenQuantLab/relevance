# Copy to /etc/alpha-lab.env on the server, fill in the values, then:
#   sudo chown root:www-data /etc/alpha-lab.env
#   sudo chmod 640 /etc/alpha-lab.env
#
# Never commit the real file – it holds secrets.

# Path the app is served under. Must match the nginx location block.
ALPHA_LAB_URL_PREFIX=/projects/alpha-lab/

# Visitors get a read-only dashboard. Enter this password in the sidebar to
# enable the Run button. Leave it out entirely to let anyone run backtests.
ALPHA_LAB_PASSWORD=choose-a-long-random-password

# Your EODHD key. Overrides the default baked into eodhd_data.py.
EODHD_API_TOKEN=your-eodhd-token
