[Unit]
Description=Prediction Revisited – Relevance Dash App
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/relevance
ExecStart=/opt/relevance/venv/bin/gunicorn \
    --bind 127.0.0.1:8050 \
    --workers 2 \
    --timeout 120 \
    app:server
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
